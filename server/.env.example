# Copy to .env and fill in. Never commit the real .env.

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/nestfinder
JWT_SECRET=<long random string>
JWT_EXPIRE=7d
NODE_ENV=development
RESEND_API_KEY=<optional — leave blank to use Gmail>
EMAIL_FROM=NestFinder <you@gmail.com>
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@nestfinder.com
ADMIN_PASSWORD=<12+ chars — used only by `node createAdmin.js`, never hardcoded>
GMAIL_USER=<your gmail address>
GMAIL_APP_PASSWORD=<16-char app password — NOT your gmail password>
TURNSTILE_SECRET_KEY=<optional — CAPTCHA is a no-op without it>
