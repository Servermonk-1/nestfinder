# Copy to .env and fill in. Never commit the real .env.

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/nestfinder
JWT_SECRET=<long random string>
JWT_EXPIRE=7d
NODE_ENV=development
# ── Email (Brevo transactional API over HTTPS) ──
# Leave BREVO_API_KEY blank to run in DEMO MODE: nothing is sent, and OTPs and
# verification links are printed to the console instead. EMAIL_FROM must be an
# address you have verified under Brevo → Senders, Domains & Dedicated IPs.
BREVO_API_KEY=<optional — blank runs in demo mode>
EMAIL_FROM=NestFinder <no-reply@yourdomain.com>
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@nestfinder.com
ADMIN_PASSWORD=<12+ chars — used only by `node createAdmin.js`, never hardcoded>
TURNSTILE_SECRET_KEY=<optional — CAPTCHA is a no-op without it>
DISABLE_OTP=<optional — set to "true" to skip the login OTP during a demo>

# ── Image & file storage (Cloudinary) ──
# REQUIRED in production. Every upload — listing photos, avatars, KYC documents
# and payment receipts — is streamed to Cloudinary and only the resulting URL is
# stored in MongoDB. Render's filesystem is ephemeral (the container is replaced
# on every deploy), so anything written to disk is lost while the database row
# pointing at it survives. Nothing is written to disk any more.
#
# Get these three from https://cloudinary.com/console (Dashboard → Product
# Environment Credentials). The free tier is ample for this project.
#
# Leave them blank locally and the API still boots — it logs a warning and only
# uploads fail.
CLOUDINARY_CLOUD_NAME=<your cloud name>
CLOUDINARY_API_KEY=<your api key>
CLOUDINARY_API_SECRET=<your api secret — treat like a password, never commit>
